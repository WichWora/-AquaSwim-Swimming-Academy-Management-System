@model AQUA.Models.Invoice

@{
    ViewData["Title"] = "Invoice Details";
    
    string GetStatusClass(string? status)
    {
        if (string.IsNullOrEmpty(status)) return "badge-warning";
        return status.ToLower() switch
        {
            "paid" => "badge-success",
            "unpaid" => "badge-warning",
            "overdue" => "badge-danger",
            _ => "badge-info"
        };
    }
}

<div class="page-header">
    <h1 class="page-title">Invoice #@Model.InvoiceNumber</h1>
    <p class="page-subtitle">Detailed breakdown of your billing statement.</p>
</div>

<div class="container" style="max-width: 900px;">
    <div class="card">
        <div class="card-header" style="justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 15px;">
                <i class="fas fa-file-invoice"></i>
                <span>Invoice Statement</span>
            </div>
            <span class="badge @GetStatusClass(Model.Status)" style="font-size: 1rem; padding: 10px 20px;">
                <i class="fas @(Model.Status == "Paid" ? "fa-check-circle" : "fa-clock")"></i>
                @Model.Status
            </span>
        </div>
        <div class="card-body" style="padding: 40px;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 50px; border-bottom: 2px solid var(--primary-softest); padding-bottom: 30px;">
                <div>
                    <h4 style="color: var(--primary-dark); margin-bottom: 15px;">Billed To:</h4>
                    <div style="font-size: 1.2rem; font-weight: 700; color: var(--secondary-dark);">@Model.FullName</div>
                    <div style="color: var(--neutral-light);">User ID: @Model.UserId</div>
                    <div style="color: var(--neutral-light);">Email: @Model.User?.Email</div>
                </div>
                <div style="text-align: right;">
                    <h4 style="color: var(--primary-dark); margin-bottom: 15px;">Invoice Details:</h4>
                    <div style="font-weight: 600;">Issue Date: <span style="font-weight: 400; color: var(--neutral-main);">@Model.IssueDate.ToString("MMMM dd, yyyy")</span></div>
                    <div style="font-weight: 600;">Due Date: <span style="font-weight: 400; color: var(--neutral-main);">@Model.DueDate.ToString("MMMM dd, yyyy")</span></div>
                    <div style="font-weight: 600; margin-top: 10px;">Reference: <span style="font-weight: 700; color: var(--primary-main);">#@Model.InvoiceNumber</span></div>
                </div>
            </div>

            <div class="table-container" style="box-shadow: none; border: 1px solid var(--neutral-lighter);">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th style="text-align: right;">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 25px;">
                                @if (Model.Schedule != null)
                                {
                                    <div style="font-weight: 600; color: var(--secondary-dark);">@Model.Schedule.Class?.ClassName - Swimming Training</div>
                                    <div style="font-size: 0.9rem; color: var(--neutral-light);">
                                        <i class="fas fa-calendar-alt"></i> @Model.Schedule.DayOfWeek | 
                                        <i class="fas fa-clock"></i> @Model.Schedule.StartTime.ToString(@"hh\:mm") - @Model.Schedule.EndTime.ToString(@"hh\:mm")
                                    </div>
                                    <div style="font-size: 0.9rem; color: var(--neutral-light);">
                                        <i class="fas fa-user-tie"></i> Coach: @Model.Schedule.Coach?.FullName | 
                                        <i class="fas fa-map-marker-alt"></i> @Model.Schedule.PoolLocation
                                    </div>
                                }
                                else
                                {
                                    <div style="font-weight: 600; color: var(--secondary-dark);">General Swimming Academy Fees</div>
                                    <div style="font-size: 0.9rem; color: var(--neutral-light);">Professional coaching and facility access.</div>
                                }
                            </td>
                            <td style="text-align: right; padding: 25px; font-weight: 700; font-size: 1.1rem; color: var(--secondary-dark);">
                                @Model.TotalAmount.ToString("C")
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr style="background: var(--primary-softest);">
                            <td style="text-align: right; font-weight: 700; padding: 25px;">Total Amount Due</td>
                            <td style="text-align: right; font-weight: 800; font-size: 1.5rem; color: var(--secondary-dark); padding: 25px;">
                                @Model.TotalAmount.ToString("C")
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            @if (Model.Payments != null && Model.Payments.Any())
            {
                <div style="margin-top: 50px;">
                    <h4 style="color: var(--primary-dark); margin-bottom: 20px;">Payment History:</h4>
                    <div class="table-container" style="box-shadow: none; border: 1px solid var(--neutral-lighter);">
                        <table class="table">
                            <thead>
                                <tr style="background: var(--neutral-lightest);">
                                    <th style="color: var(--neutral-dark);">Payment ID</th>
                                    <th style="color: var(--neutral-dark);">Date</th>
                                    <th style="color: var(--neutral-dark);">Method</th>
                                    <th style="color: var(--neutral-dark); text-align: right;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.Payments)
                                {
                                    <tr>
                                        <td>@p.PaymentId</td>
                                        <td>@p.PaymentDate.ToString("MMM dd, yyyy HH:mm")</td>
                                        <td>@p.Method</td>
                                        <td style="text-align: right; font-weight: 600;">@p.Amount.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <div style="margin-top: 60px; display: flex; justify-content: space-between; align-items: center;">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to List
                </a>
                <div style="display: flex; gap: 15px;">
                    <button onclick="window.print()" class="btn btn-outline">
                        <i class="fas fa-print"></i> Print
                    </button>
                    @if (Model.Status != "Paid")
                    {
                        <a asp-controller="Payment" asp-action="Pay" asp-route-id="@Model.InvoiceId" class="btn btn-success btn-lg">
                            <i class="fas fa-credit-card"></i> Pay Now (@Model.TotalAmount.ToString("C"))
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
