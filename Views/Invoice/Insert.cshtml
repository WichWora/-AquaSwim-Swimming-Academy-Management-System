@model AQUA.ViewModels.InvoiceVM

@{
    ViewData["Title"] = "Create Invoice";
}

<div class="page-header">
    <h1 class="page-title">Generate New Invoice</h1>
    <p class="page-subtitle">Review the billing details before confirming the invoice generation.</p>
</div>

<div class="container" style="max-width: 800px;">
    <div class="card">
        <div class="card-header">
            <i class="fas fa-file-invoice"></i>
            <span>Invoice Details</span>
        </div>
        <div class="card-body">
            <form asp-action="Insert" method="post">
                <input type="hidden" asp-for="FullName" />
                <input type="hidden" asp-for="IssueDate" />
                <input type="hidden" asp-for="ScheduleId" />

                <div class="row" style="display: flex; gap: 20px; margin-bottom: 20px;">
                    <div class="form-group" style="flex: 1;">
                        <label asp-for="InvoiceId" class="form-label">System Invoice ID</label>
                        <input asp-for="InvoiceId" class="form-control" readonly style="background-color: var(--primary-softest);" />
                        <span asp-validation-for="InvoiceId" class="alert-danger" style="font-size: 0.85rem; padding: 5px; border: none; background: none;"></span>
                    </div>
                    <div class="form-group" style="flex: 1;">
                        <label asp-for="InvoiceNumber" class="form-label">Reference Number</label>
                        <input asp-for="InvoiceNumber" class="form-control" readonly style="background-color: var(--primary-softest);" />
                    </div>
                </div>

                <div class="row" style="display: flex; gap: 20px; margin-bottom: 20px;">
                    <div class="form-group" style="flex: 1;">
                        <label asp-for="UserId" class="form-label">Customer ID</label>
                        <input asp-for="UserId" class="form-control" readonly style="background-color: var(--primary-softest);" />
                        <span asp-validation-for="UserId" class="alert-danger" style="font-size: 0.85rem; padding: 5px; border: none; background: none;"></span>
                    </div>
                    <div class="form-group" style="flex: 1;">
                        <label class="form-label">Customer Name</label>
                        <input value="@Model.FullName" class="form-control" readonly style="background-color: var(--primary-softest);" />
                    </div>
                </div>

                <div class="row" style="display: flex; gap: 20px; margin-bottom: 20px;">
                    <div class="form-group" style="flex: 1;">
                        <label asp-for="TotalAmount" class="form-label">Amount Due</label>
                        <div style="position: relative;">
                            <span style="position: absolute; left: 15px; top: 16px; font-weight: 700; color: var(--primary-dark);">$</span>
                            <input asp-for="TotalAmount" class="form-control" style="padding-left: 35px;" readonly />
                        </div>
                    </div>
                    <div class="form-group" style="flex: 1;">
                        <label asp-for="DueDate" class="form-label">Due Date</label>
                        <input asp-for="DueDate" class="form-control" type="date" />
                        <span asp-validation-for="DueDate" class="alert-danger" style="font-size: 0.85rem; padding: 5px; border: none; background: none;"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Status" class="form-label">Initial Status</label>
                    <input asp-for="Status" class="form-control" readonly style="background-color: var(--primary-softest);" />
                </div>

                <div style="margin-top: 40px; display: flex; justify-content: space-between; align-items: center;">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fas fa-check-circle"></i> Confirm
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
