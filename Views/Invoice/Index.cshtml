@model IEnumerable<AQUA.Models.Invoice>

@{
    ViewData["Title"] = "My Invoices";
    
    string GetStatusClass(string? status)
    {
        if (string.IsNullOrEmpty(status)) return "badge-warning";
        return status.ToLower() switch
        {
            "paid" => "badge-success",
            "unpaid" => "badge-warning",
            "overdue" => "badge-danger",
            _ => "badge-info"
        };
    }
}

<div class="page-header">
    <h1 class="page-title">Billing & Invoices</h1>
    <p class="page-subtitle">Manage your payments and view your billing history.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle"></i>
        @TempData["Success"]
    </div>
}

<div class="table-container">
    <table class="table">
        <thead>
            <tr>
                <th>Invoice #</th>
                <th>Recipient</th>
                <th>Issue Date</th>
                <th>Due Date</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.InvoiceNumber</strong></td>
                    <td>
                        <div style="font-weight: 600;">@item.FullName</div>
                        <div style="font-size: 0.85rem; color: var(--neutral-light);">ID: @item.UserId</div>
                    </td>
                    <td>@item.IssueDate.ToString("MMM dd, yyyy")</td>
                    <td>@item.DueDate.ToString("MMM dd, yyyy")</td>
                    <td style="font-weight: 700; color: var(--secondary-dark);">
                        @item.TotalAmount.ToString("C")
                    </td>
                    <td>
                        <span class="badge @GetStatusClass(item.Status)">
                            <i class="fas @(item.Status == "Paid" ? "fa-check" : "fa-clock")"></i>
                            @item.Status
                        </span>
                    </td>
                    <td>
                        <div class="badge-group">
                            <a asp-action="Details" asp-route-id="@item.InvoiceId" class="btn btn-info btn-sm">
                                <i class="fas fa-eye"></i> Details
                            </a>
                            @if (item.Status != "Paid")
                            {
                                <a href="/Payment/Pay/@item.InvoiceId" class="btn btn-success btn-sm">
                                    <i class="fas fa-credit-card"></i> Pay Now
                                </a>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="card" style="margin-top: 30px; text-align: center; padding: 60px;">
        <i class="fas fa-file-invoice-dollar" style="font-size: 4rem; color: var(--primary-soft); margin-bottom: 20px;"></i>
        <h3>No Invoices Found</h3>
        <p>You don't have any billing statements at the moment.</p>
        @if (User.IsInRole("Manager") || User.IsInRole("ServerAdmin"))
        {
            <div style="margin-top: 20px;">
                <a asp-action="Insert" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Create First Invoice
                </a>
            </div>
        }
    </div>
}
else if (User.IsInRole("Manager") || User.IsInRole("ServerAdmin"))
{
    <div style="margin-top: 30px; text-align: right;">
        <a asp-action="Insert" class="btn btn-primary">
            <i class="fas fa-plus"></i> Create New Invoice
        </a>
    </div>
}
