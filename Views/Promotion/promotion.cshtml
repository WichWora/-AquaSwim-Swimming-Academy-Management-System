@{
    Layout = "_Layout";
    ViewBag.Title = "Plans & Pricing";
}

@section Styles {
    <link rel="stylesheet" href="~/css/promotion.css" />
    <link rel="stylesheet" href="~/js/review.js" />
}


<section class="experience" id="experience">
    <div class="experience__content">
        <div class="section__header">
            <h2 class="subtitle">Professional Swimming Classes</h2>
            <h1 class="title">Master Swimming with Expert Coaches</h1>
        </div>


        <p class="description">
            Learn to swim or improve your technique with our certified swimming instructors.
            From beginners to advanced swimmers, we offer personalized training programs
            for all ages and skill levels in a safe, supportive environment.
        </p>

        @* link to class *@
        <div class="experience__btn">
            <a href="#pools" class="btn btn-primary">
                <i class="fas fa-swimmer"></i>
                View Our Programs
            </a>
        </div>


    </div>
    <!-- Stats Section -->
    <div class="experience__stats">
        <div class="stat-item" data-stat="classes">
            <h4 class="stat-value">15<span>+</span></h4>
            <p class="stat-label">Class Types</p>
        </div>
        <div class="stat-item" data-stat="coaches">
            <h4 class="stat-value">25<span>+</span></h4>
            <p class="stat-label">Certified Coaches</p>
        </div>
        <div class="stat-item" data-stat="students">
            <h4 class="stat-value">3000<span>+</span></h4>
            <p class="stat-label">Happy Students</p>
        </div>
        <div class="stat-item" data-stat="success">
            <h4 class="stat-value">98<span>%</span></h4>
            <p class="stat-label">Success Rate</p>
        </div>
    </div>

</section>



