        <!-- Add Your Testimonial Section -->
<section class="staff-feedback-section">
    <div class="container">

        <h2 class="section-title">Staff Feedback</h2>
        <p class="section-subtitle">
            We value our staff and instructors. Please share your experience to help us improve Aqua Swim.
        </p>

        <div class="feedback-content">

            <!-- LEFT: FORM -->
            <div class="feedback-form-container">
                <form class="feedback-form">

                    <div class="form-group">
                        <label>Full Name</label>
                        <input type="text" placeholder="Enter your name" required />
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" placeholder="Enter your email" required />
                    </div>

                    <div class="form-group">
                        <label>Role</label>
                        <select required>
                            <option value="">Select role</option>
                            <option>Swimming Instructor</option>
                            <option>Lifeguard</option>
                            <option>Reception Staff</option>
                            <option>Management</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Feedback Type</label>
                        <div class="feedback-types">
                            <label class="feedback-type-option">
                                <input type="radio" name="type" required />
                                <span class="option-content">Suggestion</span>
                            </label>

                            <label class="feedback-type-option">
                                <input type="radio" name="type" />
                                <span class="option-content">Complaint</span>
                            </label>

                            <label class="feedback-type-option">
                                <input type="radio" name="type" />
                                <span class="option-content">Appreciation</span>
                            </label>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Message</label>
                        <textarea rows="5" placeholder="Write your feedback here..." required></textarea>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-submit">
                            Submit Feedback
                        </button>
                    </div>

                </form>
            </div>

            <!-- RIGHT: INFO PANEL -->
            <div class="feedback-info">
                <h3>Why Your Feedback Matters</h3>
                <ul>
                    <li>✔ Improve staff working environment</li>
                    <li>✔ Enhance training quality</li>
                    <li>✔ Build a better Aqua Swim team</li>
                </ul>
                <p class="note">
                    All feedback is confidential and reviewed by management.
                </p>
            </div>

        </div>
    </div>
</section>





            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    const form = document.getElementById("staffFeedbackForm");
                    const comment = document.getElementById("staffComment");
                    const charCount = document.getElementById("charCount");
                    const successMessage = document.getElementById("successMessage");
                    const emailDisplay = document.getElementById("userEmailDisplay");

                    // Character counter
                    comment.addEventListener("input", function () {
                        charCount.textContent = comment.value.length;
                        if (comment.value.length > 500) {
                            comment.value = comment.value.substring(0, 500);
                        }
                    });

                    // Form submit
                    form.addEventListener("submit", function (e) {
                        e.preventDefault();

                        const email = document.getElementById("feedbackEmail").value;

                        // Show success message
                        emailDisplay.textContent = email;
                        successMessage.style.display = "block";
                        form.style.display = "none";

                        // OPTIONAL: send to backend later (AJAX / MVC / API)
                        // fetch("/Feedback/Submit", { method: "POST", body: new FormData(form) });
                    });
                });

                // Close success message
                function hideSuccessMessage() {
                    document.getElementById("successMessage").style.display = "none";
                    document.getElementById("staffFeedbackForm").style.display = "block";
                    document.getElementById("staffFeedbackForm").reset();
                    document.getElementById("charCount").textContent = "0";
                }
            </script>
 