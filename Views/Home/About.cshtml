@{
    ViewData["Title"] = "About Us - AquaSwimming Academy";
}

<section class="hero-section">
    <div class="hero-content">
        <h1 class="hero-title" data-translate="About AquaSwimming Academy">About AquaSwimming Academy</h1>
        <p class="hero-subtitle" data-translate="Your journey to swimming excellence begins here">Your journey to swimming excellence begins here</p>
    </div>
</section>

<section class="main-content">
    <div class="container">
        <div class="row align-center">
            <div class="col-md-6 mb-4">
                <h2 class="mb-4" data-translate="Our Story">Our Story</h2>
                <p class="mb-3" data-translate="Founded in 2010, AquaSwimming Academy began with a simple mission: to make swimming accessible, safe, and enjoyable for everyone. What started as a small community swimming program has grown into a premier aquatic education center.">
                    Founded in 2010, AquaSwimming Academy began with a simple mission: to make swimming accessible, safe, and enjoyable for everyone. What started as a small community swimming program has grown into a premier aquatic education center.
                </p>
                <p class="mb-3" data-translate="Over the past decade, we've taught thousands of students, from toddlers taking their first strokes to adults conquering their fear of water, and competitive swimmers honing their technique for national competitions.">
                    Over the past decade, we've taught thousands of students, from toddlers taking their first strokes to adults conquering their fear of water, and competitive swimmers honing their technique for national competitions.
                </p>
                <p data-translate="Our academy is built on three core principles: Safety First, Progressive Learning, and Individual Attention.">
                    Our academy is built on three core principles: Safety First, Progressive Learning, and Individual Attention.
                </p>
            </div>
            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-header">
                        <i class="fas fa-swimming-pool me-2"></i>
                        <span data-translate="Our Facilities">Our Facilities</span>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled">
                            <li class="mb-2">
                                <i class="fas fa-check text-success me-2"></i>
                                <span data-translate="Two Olympic-sized heated pools">Two Olympic-sized heated pools</span>
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-check text-success me-2"></i>
                                <span data-translate="Temperature-controlled water year-round">Temperature-controlled water year-round</span>
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-check text-success me-2"></i>
                                <span data-translate="Advanced filtration and sanitation systems">Advanced filtration and sanitation systems</span>
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-check text-success me-2"></i>
                                <span data-translate="Separate beginner and advanced pools">Separate beginner and advanced pools</span>
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-check text-success me-2"></i>
                                <span data-translate="State-of-the-art safety equipment">State-of-the-art safety equipment</span>
                            </li>
                            <li>
                                <i class="fas fa-check text-success me-2"></i>
                                <span data-translate="Spacious changing rooms and amenities">Spacious changing rooms and amenities</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-5">
            <div class="col-12">
                <h2 class="text-center mb-5" data-translate="Our Team of Experts">Our Team of Experts</h2>
            </div>
        </div>

        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fas fa-user-tie"></i>
                </div>
                <h3 class="feature-title" data-translate="Certified Instructors">Certified Instructors</h3>
                <p class="feature-description" data-translate="All our coaches are certified by national swimming associations with minimum 5 years of teaching experience.">
                    All our coaches are certified by national swimming associations with minimum 5 years of teaching experience.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fas fa-medal"></i>
                </div>
                <h3 class="feature-title" data-translate="Competitive Experience">Competitive Experience</h3>
                <p class="feature-description" data-translate="Many of our coaches are former competitive swimmers with national and international competition experience.">
                    Many of our coaches are former competitive swimmers with national and international competition experience.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fas fa-heartbeat"></i>
                </div>
                <h3 class="feature-title" data-translate="Safety First">Safety First</h3>
                <p class="feature-description" data-translate="Every staff member is certified in CPR, First Aid, and lifeguarding to ensure maximum safety.">
                    Every staff member is certified in CPR, First Aid, and lifeguarding to ensure maximum safety.
                </p>
            </div>
        </div>

        <div class="row mt-5">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <i class="fas fa-award me-2"></i>
                        <span data-translate="Our Accreditations">Our Accreditations</span>
                    </div>

                    <div class="card-body">
                        <div class="badge-group">
                            <div class="col-md-3 mb-3">
                                <div class="badge badge-primary p-3">
                                    <i class="fas fa-swimmer fa-2x mb-2"></i>
                                    <div data-translate="Swim Australia">Swim Australia</div>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <div class="badge badge-success p-3">
                                    <i class="fas fa-shield-alt fa-2x mb-2"></i>
                                    <div data-translate="Royal Life Saving">Royal Life Saving</div>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <div class="badge badge-info p-3">
                                    <i class="fas fa-star fa-2x mb-2"></i>
                                    <div data-translate="5-Star Facility">5-Star Facility</div>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <div class="badge badge-warning p-3">
                                    <i class="fas fa-check-circle fa-2x mb-2"></i>
                                    <div data-translate="ISO Certified">ISO Certified</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-5">
            <div class="col-md-8 mx-auto">
                <div class="card">
                    <div class="card-header">
                        <i class="fas fa-quote-left me-2"></i>
                        <span data-translate="Our Mission">Our Mission</span>
                    </div>
                    <div class="card-body text-center">
                        <blockquote class="blockquote">
                            <p class="mb-0" data-translate='"To provide a safe, supportive, and professional environment where individuals of all ages and abilities can develop swimming skills, build confidence, and foster a lifelong love for aquatic activities."'>
                                "To provide a safe, supportive, and professional environment where individuals of all ages and abilities can develop swimming skills, build confidence, and foster a lifelong love for aquatic activities."
                            </p>
                            <footer class="blockquote-footer mt-3" data-translate="AquaSwimming Academy Team">AquaSwimming Academy Team</footer>
                        </blockquote>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-5">
            <a asp-controller="Home" asp-action="Contact" class="btn btn-primary btn-lg me-3">
                <i class="fas fa-envelope me-2"></i>
                <span data-translate="Contact Us">Contact Us</span>
            </a>
            <a asp-controller="Classes" asp-action="Index" class="btn btn-outline btn-lg">
                <i class="fas fa-swimming-pool me-2"></i>
                <span data-translate="View Classes">View Classes</span>
            </a>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Ensure language switcher works on this page
        document.addEventListener('DOMContentLoaded', function() {
            if (window.languageSwitcher) {
                window.languageSwitcher.applyTranslations();
            }
        });
    </script>
}