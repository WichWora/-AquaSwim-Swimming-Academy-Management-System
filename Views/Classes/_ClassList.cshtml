@using AQUA
@model IEnumerable<AQUA.Models.Class>

@foreach (var item in Model)
{
    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <!-- Card Header with Status -->
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold text-primary">@item.ClassName</h5>
                @if (item.IsActive)
                {
                    <span class="badge badge-success">
                        <i class="bi bi-check-circle me-1"></i>Active
                    </span>
                }
                else
                {
                    <span class="badge badge-secondary">
                        <i class="bi bi-pause-circle me-1"></i>Inactive
                    </span>
                }
            </div>

            <div class="card-body">
                <!-- Level Badge -->
                <div class="mb-3">
                    <span class="badge @GetLevelBadgeClass(item.Level)">
                        @item.Level
                    </span>
                </div>

                <!-- Description -->
                <p class="card-text mb-4">
                    @if (!string.IsNullOrEmpty(item.Description))
                    {
                        @item.Description
                    }
                    else
                    {
                        <span class="text-muted">No description provided</span>
                    }
                </p>

                <!-- Quick Info -->
                <div class="small text-muted">
                    <div class="mb-2">
                        <i class="bi bi-people me-2"></i>
                        Max Capacity: @item.MaxCapacity students
                    </div>
                    <div>
                        <i class="bi bi-currency-dollar me-2"></i>
                        Fee: RM@item.Fee.ToString("F2")
                    </div>
                </div>
            </div>

            <!-- Card Footer -->
            <div class="card-footer bg-transparent">
                <div class="d-flex justify-content-between">
                    <a asp-action="Details" asp-route-id="@item.ClassId"
                       class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-eye me-1"></i>View
                    </a>

                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <div class="btn-group" role="group">
                            <a asp-action="Edit" asp-route-id="@item.ClassId"
                               class="btn btn-outline-warning btn-sm">
                                <i class="bi bi-pencil"></i>
                            </a>
                            @if (item.IsActive)
                            {
                                <a asp-action="Delete" asp-route-id="@item.ClassId"
                                   class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash"></i>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@functions {
    string GetLevelBadgeClass(string level)
    {
        return level switch
        {
            "Beginner" => "badge-info",
            "Intermediate" => "badge-primary",
            "Advanced" => "badge-warning",
            "Competitive" => "badge-danger",
            _ => "badge-secondary"
        };
    }
}